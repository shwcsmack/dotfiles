#!/bin/bash
# Mac packages — re-runs only when this file's hash changes
set -e

# Clean up the dead fonts tap if it's still around
brew untap homebrew/homebrew-cask-fonts 2>/dev/null || true

brew update

brew install \
  starship git ripgrep fd fzf bat eza zoxide jq lazygit chezmoi \
  neovim tmux zellij ghostty

# --force lets this re-run even when fonts are already installed
brew install --cask --force font-jetbrains-mono-nerd-font font-hack-nerd-font
